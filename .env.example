# =============================================================================
# Environment variables for PIKOM FT
# Copy this file to `.env` (local dev) atau `.env.production` (production).
# Do NOT commit real secrets. Generate strong AUTH_SECRET dengan:
#   openssl rand -base64 32
# =============================================================================

# --- Database (PostgreSQL) ----------------------------------------------------
# Production: gunakan koneksi pooled (mis. Neon/Supabase/RDS). Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/pikom_ft?schema=public"

# Opsional: koneksi langsung (non-pooled) untuk `prisma migrate`/seed.
# DIRECT_URL="postgresql://user:password@localhost:5432/pikom_ft?schema=public"

# --- Auth.js (NextAuth v5) ----------------------------------------------------
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"

# Set ke URL publik aplikasi saat production (https://domainmu.id)
# AUTH_URL="https://app.example.com"
# AUTH_TRUST_HOST="true"

# --- App ---------------------------------------------------------------------
# Digunakan untuk metadataBase, canonical URL, dan absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3077"

# Node environment (Next.js mengatur otomatis, tetapi boleh override)
# NODE_ENV="production"
