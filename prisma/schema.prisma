generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MAHASISWA
  PENGURUS
  ADMIN
}

enum Jabatan {
  KETUA_UMUM
  SEKRETARIS_UMUM
  BENDAHARA_UMUM
  KETUA_BIDANG
  ANGGOTA_BIDANG
}

enum TipeSurat {
  MASUK
  KELUAR
}

enum KategoriAturan {
  TOR
  AD_ART
  SOP
  LAIN
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum LandingProkerStatus {
  TERLAKSANA
  DIRENCANAKAN
}

enum LandingMemberRole {
  ANGGOTA
}

model User {
  id        String   @id @default(cuid())
  nim       String   @unique
  name      String
  email     String?
  prodi     String?
  password  String
  role      Role     @default(MAHASISWA)
  jabatan   Jabatan?
  bidang    String?
  source    String   @default("LOCAL") // LOCAL | SIMAK
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress    Progress[]
  prokerMade  Proker[]    @relation("ProkerCreator")
  suratMade   Surat[]     @relation("SuratCreator")
  aturanMade  Aturan[]    @relation("AturanCreator")
  transaksiMade Transaksi[] @relation("TransaksiCreator")
  landingAssets LandingAsset[] @relation("LandingAssetUploader")
}

/// Asset gambar untuk landing pages (hero, pimpinan inti, ketua bidang, dst).
/// `key` = slot identifier yang stabil, dipakai di komponen.
/// Conoth key: `hero.1`, `hero.2`, `pimpinan.ketua-umum`, `bidang.organisasi.ketua`.
model LandingAsset {
  id         String   @id @default(cuid())
  key        String   @unique
  url        String
  alt        String?
  uploadedBy String?
  uploader   User?    @relation("LandingAssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Key-value untuk teks bebas landing pages (hero tagline, about quote, stats label, dll).
/// Admin dapat edit semua key dari satu UI.
model LandingContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  /// Group untuk pengelompokan UI (Hero, About, Stats, Footer, ...).
  groupName String   @default("Umum")
  /// Label friendly untuk admin UI.
  label     String?
  /// Apakah value adalah long-form text (gunakan textarea di admin).
  multiline Boolean  @default(false)
  /// Urutan tampil di group.
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Pimpinan inti komisariat (5 entry default: Ketua Umum, Sekum, Bendum, Ben1, Ben2).
model LandingPimpinan {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  role      String?
  nama      String
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bidang organisasi. Detail page menampilkan struktur + proker dari sini.
model LandingBidang {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// Nama icon Lucide (mis. "Network", "Users").
  icon      String   @default("Sparkles")
  desc      String
  ketua     String?
  sekretaris String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anggota LandingBidangAnggota[]
  proker  LandingProker[]
}

model LandingBidangAnggota {
  id       String @id @default(cuid())
  bidangId String
  nama     String
  order    Int    @default(0)

  bidang LandingBidang @relation(fields: [bidangId], references: [id], onDelete: Cascade)
}

model LandingProker {
  id       String              @id @default(cuid())
  bidangId String
  title    String
  status   LandingProkerStatus
  order    Int                 @default(0)

  bidang LandingBidang @relation(fields: [bidangId], references: [id], onDelete: Cascade)
}

/// Periode kepengurusan sebelumnya (timeline jejak kepemimpinan).
model LandingPeriode {
  id      String @id @default(cuid())
  periode String
  ketua   String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  title     String
  status    String   @default("belum")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfilOrganisasi {
  id          String @id @default(cuid())
  key         String @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model Proker {
  id          String   @id @default(cuid())
  bidang      String
  title       String
  status      String   @default("direncanakan")
  deskripsi   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User? @relation("ProkerCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Surat {
  id          String    @id @default(cuid())
  tipe        TipeSurat
  nomor       String
  tanggal     DateTime
  perihal     String
  pengirim    String?
  tujuan      String?
  lampiranUrl String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User? @relation("SuratCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Aturan {
  id          String         @id @default(cuid())
  judul       String
  kategori    KategoriAturan
  konten      String?
  lampiranUrl String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator User? @relation("AturanCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Transaksi {
  id          String        @id @default(cuid())
  tipe        TipeTransaksi
  tanggal     DateTime
  kategori    String
  jumlah      Int
  deskripsi   String?
  pihak       String?
  bidang      String?
  notaUrl     String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator User? @relation("TransaksiCreator", fields: [createdById], references: [id], onDelete: SetNull)
}
